{
  "name": "copilot-amplify",
  "version": "1.0.15",
  "displayName": "Copilot Amplify",
  "description": "Extend GitHub Copilot Chat with additional AI model providers",
  "author": "Md Mojahid",
  "publisher": "LuneCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojahid2021/copilot-amplify"
  },
  "license": "ISC",
  "keywords": [
    "xiaomi",
    "mimo",
    "glm",
    "zai",
    "nvidia",
    "nim",
    "ai",
    "chat",
    "copilot",
    "language-model",
    "provider"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Copilot Amplify",
      "type": "object",
      "properties": {
        "copilot-amplify.xiaomi.apiKey": {
          "type": "string",
          "markdownDescription": "Xiaomi MiMo API Key. Get yours from the [Xiaomi MiMo console](https://www.xiaomimimo.com/). Both Pay-as-you-go (`sk-...`) and Token Plan (`tp-...`) keys are supported.",
          "secret": true
        },
        "copilot-amplify.glm.apiKey": {
          "type": "string",
          "markdownDescription": "Z.ai GLM API Key. Get yours from the [Z.ai console](https://z.ai/).",
          "secret": true
        },
        "copilot-amplify.groq.apiKey": {
          "type": "string",
          "markdownDescription": "Groq API Key. Get yours from the [Groq console](https://console.groq.com/).",
          "secret": true
        },
        "copilot-amplify.nvidia.apiKey": {
          "type": "string",
          "markdownDescription": "NVIDIA NIM API Key. Get yours from the [NVIDIA build site](https://build.nvidia.com/).",
          "secret": true
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-amplify-view-container",
          "title": "Copilot Amplify",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilot-amplify-view-container": [
        {
          "id": "copilot-amplify.providers",
          "name": "Providers",
          "type": "tree"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilot-amplify.refresh",
          "when": "view == copilot-amplify.providers",
          "group": "0_copilot-amplify/navigation"
        },
        {
          "command": "copilot-amplify.openChat",
          "when": "view == copilot-amplify.providers",
          "group": "0_copilot-amplify/navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "copilot-amplify.openChat",
          "when": "view == copilot-amplify.providers && viewItem == 'provider'",
          "group": "inline@0"
        },
        {
          "command": "copilot-amplify.setApiKey",
          "when": "view == copilot-amplify.providers && viewItem == 'provider'",
          "group": "inline@1"
        },
        {
          "command": "copilot-amplify.testConnection",
          "when": "view == copilot-amplify.providers && viewItem == 'provider'",
          "group": "inline@2"
        },
        {
          "command": "copilot-amplify.clearApiKey",
          "when": "view == copilot-amplify.providers && viewItem == 'provider'",
          "group": "inline@3"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "LuneCode.xiaomi",
        "displayName": "Xiaomi"
      },
      {
        "vendor": "LuneCode.glm",
        "displayName": "Z.ai"
      },
      {
        "vendor": "LuneCode.groq",
        "displayName": "Groq"
      },
      {
        "vendor": "LuneCode.nvidia",
        "displayName": "NVIDIA NIM"
      }
    ],
    "commands": [
      {
        "command": "copilot-amplify.refresh",
        "title": "Refresh",
        "icon": "$(sync)"
      },
      {
        "command": "copilot-amplify.manage",
        "title": "Manage Providers..."
      },
      {
        "command": "copilot-amplify.setApiKey",
        "title": "Set API Key"
      },
      {
        "command": "copilot-amplify.testConnection",
        "title": "Test Connection"
      },
      {
        "command": "copilot-amplify.clearApiKey",
        "title": "Clear API Key"
      },
      {
        "command": "copilot-amplify.provider.click",
        "title": "Open Provider",
        "enablement": "false"
      },
      {
        "command": "copilot-amplify.openChat",
        "title": "Chat",
        "icon": "$(comment)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true }); require('fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "openai": "^6.48.0",
    "secure-json-parse": "^4.1.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
