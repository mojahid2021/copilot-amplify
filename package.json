{
  "name": "copilot-amplify",
  "version": "2.4.0",
  "displayName": "Copilot Amplify",
  "description": "Extend GitHub Copilot Chat with additional AI model providers",
  "author": "Md Mojahid",
  "publisher": "mojahid2021",
  "repository": {
    "type": "git",
    "url": "https://github.com/mojahid2021/copilot-amplify"
  },
  "license": "ISC",
  "keywords": [
    "xiaomi",
    "mimo",
    "glm",
    "zai",
    "nvidia",
    "nim",
    "omniroute",
    "agentrouter",
    "ai",
    "chat",
    "copilot",
    "language-model",
    "provider"
  ],
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "General",
        "properties": {
          "copilot-amplify.customSystemPrompt": {
            "type": "string",
            "default": "",
            "markdownDescription": "Extra instructions added in front of the system prompt for every request, on every provider. Leave empty to send Copilot's prompt unchanged.",
            "order": 1,
            "editPresentation": "multilineText"
          },
          "copilot-amplify.enableReasoning": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Let models that support it think before answering (for example Kimi K3, GLM, Claude). Turn off for faster, cheaper replies.",
            "order": 2
          },
          "copilot-amplify.requestTimeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 1000,
            "markdownDescription": "How long to wait for a reply, in milliseconds, before giving up. Applies to Xiaomi MiMo, Z.ai, Groq and NVIDIA NIM.",
            "order": 3
          },
          "copilot-amplify.debugLogging": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Write detailed logs to the **Copilot Amplify** output channel. Useful when reporting a problem; API keys are never logged.",
            "order": 4
          },
          "copilot-amplify.loadModelsOnStartup": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Load model lists for Xiaomi MiMo, Z.ai, Groq and NVIDIA NIM right after VS Code starts. Lists are also kept between sessions, so this is only needed to pick up new models automatically."
          },
          "copilot-amplify.modelListTimeoutMs": {
            "type": "number",
            "default": 8000,
            "minimum": 1000,
            "order": 6,
            "markdownDescription": "How long to wait, in milliseconds, when loading a model list or testing the connection for Xiaomi MiMo, Z.ai, Groq and NVIDIA NIM."
          }
        }
      },
      {
        "title": "Reliability",
        "properties": {
          "copilot-amplify.circuitBreaker.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "After several failed requests in a row, pause requests to that provider for a short cooldown instead of failing slowly each time.",
            "order": 1
          },
          "copilot-amplify.circuitBreaker.failureThreshold": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "markdownDescription": "Number of failed requests in a row that pauses a provider.",
            "order": 2
          },
          "copilot-amplify.circuitBreaker.resetTimeoutSeconds": {
            "type": "number",
            "default": 30,
            "minimum": 5,
            "markdownDescription": "How long a paused provider waits, in seconds, before one request is allowed through to check whether it has recovered.",
            "order": 3
          }
        }
      },
      {
        "title": "OmniRoute",
        "properties": {
          "copilot-amplify.CA-omniroute.baseUrl": {
            "type": "string",
            "default": "http://localhost:20128/v1",
            "markdownDescription": "Address of your OmniRoute server, including the `/v1` path, for example `http://localhost:20128/v1`. Models load only after this is set.",
            "order": 1
          },
          "copilot-amplify.CA-omniroute.requestTimeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 1000,
            "markdownDescription": "How long to wait for a reply, in milliseconds, including the whole streamed answer.",
            "order": 2
          },
          "copilot-amplify.CA-omniroute.discoveryTimeoutMs": {
            "type": "number",
            "default": 8000,
            "minimum": 500,
            "markdownDescription": "How long to wait, in milliseconds, when loading models or testing the connection.",
            "order": 3
          },
          "copilot-amplify.CA-omniroute.modelCacheTtlSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 10,
            "markdownDescription": "How long, in seconds, a loaded model list counts as up to date. The list stays usable after it expires.",
            "order": 4
          },
          "copilot-amplify.CA-omniroute.warmupOnStartup": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Load OmniRoute models automatically when VS Code starts. When off, models load only when you select **Load Models**.",
            "order": 5
          },
          "copilot-amplify.CA-omniroute.noCache": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Skip OmniRoute's response cache (sends `X-OmniRoute-No-Cache`). Leave off so repeated requests are answered from the cache at no cost.",
            "order": 6
          },
          "copilot-amplify.CA-omniroute.noMemory": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Don't add OmniRoute memory and skills to requests (sends `x-omniroute-no-memory`), which avoids their extra token cost.",
            "order": 7
          },
          "copilot-amplify.CA-omniroute.compression": {
            "type": "string",
            "default": "",
            "markdownDescription": "Compression mode for requests: `off`, `default`, `engine:<id>` (for example `engine:rtk`) or a combo id. Leave empty to let the server decide.",
            "order": 8
          },
          "copilot-amplify.CA-omniroute.sessionId": {
            "type": "string",
            "default": "",
            "markdownDescription": "Session tag for cost tracking and memory (sent as `X-OmniRoute-Session-Id`). Leave empty to use one generated per VS Code window.",
            "order": 9
          },
          "copilot-amplify.CA-omniroute.progress": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Ask the server for progress events while it routes a request (sends `X-OmniRoute-Progress`).",
            "order": 10
          },
          "copilot-amplify.CA-omniroute.logTelemetry": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Log each response's route, model, latency, tokens and cost to the **Copilot Amplify** output channel.",
            "order": 11
          },
          "copilot-amplify.CA-omniroute.debugLogging": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Write detailed OmniRoute logs to the **Copilot Amplify** output channel.",
            "order": 12
          }
        }
      },
      {
        "title": "AgentRouter",
        "properties": {
          "copilot-amplify.CA-agentrouter.baseUrl": {
            "type": "string",
            "default": "https://agentrouter.org/v1",
            "markdownDescription": "AgentRouter address, including the `/v1` path. Claude models use the same address without `/v1`.",
            "order": 1
          },
          "copilot-amplify.CA-agentrouter.requestTimeoutMs": {
            "type": "number",
            "default": 120000,
            "minimum": 1000,
            "markdownDescription": "How long to wait for a reply, in milliseconds, including the whole streamed answer.",
            "order": 2
          },
          "copilot-amplify.CA-agentrouter.discoveryTimeoutMs": {
            "type": "number",
            "default": 8000,
            "minimum": 500,
            "markdownDescription": "How long to wait, in milliseconds, when loading models or testing the connection.",
            "order": 3
          },
          "copilot-amplify.CA-agentrouter.cacheTtlSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 10,
            "markdownDescription": "How long, in seconds, a loaded model list counts as up to date. The list stays usable after it expires.",
            "order": 4
          },
          "copilot-amplify.CA-agentrouter.warmupOnStartup": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "Load AgentRouter models automatically when VS Code starts. When off, models load only when you select **Load Models**.",
            "order": 5
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilot-amplify-view-container",
          "title": "Copilot Amplify",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilot-amplify-view-container": [
        {
          "id": "copilot-amplify.providers",
          "name": "Providers & Models",
          "type": "tree",
          "icon": "media/icon.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "copilot-amplify.loadModels",
          "when": "false"
        },
        {
          "command": "copilot-amplify.selectModel",
          "when": "false"
        },
        {
          "command": "copilot-amplify.pinModel",
          "when": "false"
        },
        {
          "command": "copilot-amplify.unpinModel",
          "when": "false"
        },
        {
          "command": "copilot-amplify.provider.click",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "copilot-amplify.refresh",
          "when": "view == copilot-amplify.providers",
          "group": "navigation@1"
        },
        {
          "command": "copilot-amplify.manage",
          "when": "view == copilot-amplify.providers",
          "group": "navigation@2"
        },
        {
          "command": "copilot-amplify.showDiagnostics",
          "when": "view == copilot-amplify.providers",
          "group": "1_tools@1"
        },
        {
          "command": "copilot-amplify.showNetworkQuality",
          "when": "view == copilot-amplify.providers",
          "group": "1_tools@2"
        },
        {
          "command": "copilot-amplify.documentation",
          "when": "view == copilot-amplify.providers",
          "group": "2_help@1"
        },
        {
          "command": "copilot-amplify.report",
          "when": "view == copilot-amplify.providers",
          "group": "2_help@2"
        }
      ],
      "view/item/context": [
        {
          "command": "copilot-amplify.loadModels",
          "when": "view == copilot-amplify.providers && (viewItem == 'dynamic-provider' || viewItem == 'omniroute-provider')",
          "group": "inline@1"
        },
        {
          "command": "copilot-amplify.loadModels",
          "when": "view == copilot-amplify.providers && (viewItem == 'dynamic-provider' || viewItem == 'omniroute-provider')",
          "group": "1_models@1"
        },
        {
          "command": "copilot-amplify.CA-omniroute.editBaseUrl",
          "when": "view == copilot-amplify.providers && viewItem == 'omniroute-provider'",
          "group": "2_setup@1"
        },
        {
          "command": "copilot-amplify.setApiKey",
          "when": "view == copilot-amplify.providers && (viewItem == 'dynamic-provider' || viewItem == 'omniroute-provider')",
          "group": "2_setup@2"
        },
        {
          "command": "copilot-amplify.clearApiKey",
          "when": "view == copilot-amplify.providers && (viewItem == 'dynamic-provider' || viewItem == 'omniroute-provider')",
          "group": "2_setup@3"
        },
        {
          "command": "copilot-amplify.testConnection",
          "when": "view == copilot-amplify.providers && (viewItem == 'dynamic-provider' || viewItem == 'omniroute-provider')",
          "group": "3_check@1"
        },
        {
          "command": "copilot-amplify.CA-omniroute.showDiagnostics",
          "when": "view == copilot-amplify.providers && viewItem == 'omniroute-provider'",
          "group": "3_check@2"
        },
        {
          "command": "copilot-amplify.CA-omniroute.showTelemetry",
          "when": "view == copilot-amplify.providers && viewItem == 'omniroute-provider'",
          "group": "3_check@3"
        },
        {
          "command": "copilot-amplify.pinModel",
          "when": "view == copilot-amplify.providers && viewItem == 'model'",
          "group": "inline@1"
        },
        {
          "command": "copilot-amplify.unpinModel",
          "when": "view == copilot-amplify.providers && viewItem == 'favorite-model'",
          "group": "inline@1"
        },
        {
          "command": "copilot-amplify.selectModel",
          "when": "view == copilot-amplify.providers && (viewItem == 'model' || viewItem == 'favorite-model')",
          "group": "1_model@1"
        },
        {
          "command": "copilot-amplify.pinModel",
          "when": "view == copilot-amplify.providers && viewItem == 'model'",
          "group": "1_model@2"
        },
        {
          "command": "copilot-amplify.unpinModel",
          "when": "view == copilot-amplify.providers && viewItem == 'favorite-model'",
          "group": "1_model@2"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "LuneCode.CA-xiaomi",
        "displayName": "CA-Xiaomi MiMo",
        "managementCommand": "copilot-amplify.manage"
      },
      {
        "vendor": "LuneCode.CA-glm",
        "displayName": "CA-Z.ai GLM",
        "managementCommand": "copilot-amplify.manage"
      },
      {
        "vendor": "LuneCode.CA-groq",
        "displayName": "CA-Groq",
        "managementCommand": "copilot-amplify.manage"
      },
      {
        "vendor": "LuneCode.CA-nvidia",
        "displayName": "CA-NVIDIA NIM",
        "managementCommand": "copilot-amplify.manage"
      },
      {
        "vendor": "LuneCode.CA-omniroute",
        "displayName": "CA-OmniRoute",
        "managementCommand": "copilot-amplify.manage"
      },
      {
        "vendor": "LuneCode.CA-agentrouter",
        "displayName": "CA-AgentRouter",
        "managementCommand": "copilot-amplify.manage"
      }
    ],
    "commands": [
      {
        "command": "copilot-amplify.manage",
        "title": "Manage Providers…",
        "category": "Copilot Amplify",
        "icon": "$(gear)"
      },
      {
        "command": "copilot-amplify.refresh",
        "title": "Refresh Providers and Models",
        "category": "Copilot Amplify",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-amplify.setApiKey",
        "title": "Set API Key…",
        "category": "Copilot Amplify",
        "icon": "$(key)"
      },
      {
        "command": "copilot-amplify.testConnection",
        "title": "Test Connection",
        "category": "Copilot Amplify",
        "icon": "$(plug)"
      },
      {
        "command": "copilot-amplify.clearApiKey",
        "title": "Remove API Key",
        "category": "Copilot Amplify",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-amplify.loadModels",
        "title": "Load Models",
        "category": "Copilot Amplify",
        "icon": "$(cloud-download)"
      },
      {
        "command": "copilot-amplify.selectModel",
        "title": "Select Model",
        "category": "Copilot Amplify",
        "icon": "$(check)"
      },
      {
        "command": "copilot-amplify.pinModel",
        "title": "Add to Favorites",
        "category": "Copilot Amplify",
        "icon": "$(star-empty)"
      },
      {
        "command": "copilot-amplify.unpinModel",
        "title": "Remove from Favorites",
        "category": "Copilot Amplify",
        "icon": "$(star-full)"
      },
      {
        "command": "copilot-amplify.provider.click",
        "title": "Open Provider",
        "category": "Copilot Amplify"
      },
      {
        "command": "copilot-amplify.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Copilot Amplify",
        "icon": "$(pulse)"
      },
      {
        "command": "copilot-amplify.showNetworkQuality",
        "title": "Show Network Quality",
        "category": "Copilot Amplify",
        "icon": "$(dashboard)"
      },
      {
        "command": "copilot-amplify.documentation",
        "title": "Open Documentation",
        "category": "Copilot Amplify",
        "icon": "$(book)"
      },
      {
        "command": "copilot-amplify.report",
        "title": "Report an Issue",
        "category": "Copilot Amplify",
        "icon": "$(report)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.configure",
        "title": "OmniRoute: Set Up…",
        "category": "Copilot Amplify",
        "icon": "$(settings-gear)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.editBaseUrl",
        "title": "OmniRoute: Change Server URL…",
        "category": "Copilot Amplify",
        "icon": "$(link)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.setApiKey",
        "title": "OmniRoute: Set API Key…",
        "category": "Copilot Amplify",
        "icon": "$(key)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.removeApiKey",
        "title": "OmniRoute: Remove API Key",
        "category": "Copilot Amplify",
        "icon": "$(trash)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.testConnection",
        "title": "OmniRoute: Test Connection",
        "category": "Copilot Amplify",
        "icon": "$(plug)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.refreshModels",
        "title": "OmniRoute: Reload Models",
        "category": "Copilot Amplify",
        "icon": "$(refresh)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.showDiagnostics",
        "title": "OmniRoute: Show Diagnostics",
        "category": "Copilot Amplify",
        "icon": "$(pulse)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.showTelemetry",
        "title": "OmniRoute: Show Request Log",
        "category": "Copilot Amplify",
        "icon": "$(output)"
      },
      {
        "command": "copilot-amplify.CA-omniroute.resetConfiguration",
        "title": "OmniRoute: Reset Settings…",
        "category": "Copilot Amplify",
        "icon": "$(discard)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true }); require('fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "openai": "^6.48.0",
    "secure-json-parse": "^4.1.0",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  }
}
